    "ai": "^6.0.199",
    "class-variance-authority": "^0.7.1",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "16.10.3",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-openapi": "^11.0.2",
    "fumadocs-ui": "16.10.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.6.0",
